model Permission {
    id              Int              @id @default(autoincrement())
    value           String           @db.VarChar(100)
    rolePermissions RolePermission[]
    createdAt       DateTime         @default(now()) @db.Timestamp()
    updatedAt       DateTime         @default(now()) @updatedAt @db.Timestamp()

    @@map("permissions")
}

