model video {
    id        Int     @id @default(autoincrement())
    title     String?
    url       String
    duration  Int?    @default(0)
    views     Int?    @default(0)
    comment   Int?    @default(0)
    thumbnail String?

    createdAt DateTime @default(now()) @db.Timestamp()
    updatedAt DateTime @default(now()) @updatedAt @db.Timestamp()

    @@map("video")
}
