model Province {
    id               Int              @id @default(autoincrement())
    name             String           @db.VarChar(100)
    createdAt        DateTime         @default(now()) @db.Timestamp()
    updatedAt        DateTime         @default(now()) @updatedAt @db.Timestamp()
    wards            Ward[]
    companyAddresses CompanyAddress[]

    @@map("provinces")
}
